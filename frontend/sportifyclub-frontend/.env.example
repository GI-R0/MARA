# Environment variables for the frontend (Vite React app)
# Copy this file to ".env" in the frontend project root and adjust values.

# Base URL of the backend API. Use full URL in production or relative path in development.
# Example (development): VITE_API_URL=http://localhost:4000/api
# Example (production): VITE_API_URL=https://api.mysportifyclub.com/api
VITE_API_URL=
