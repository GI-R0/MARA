# 🚀 VARIABLES DE PRODUCCIÓN - BACKEND
# ⚠️ NUNCA COMMITS ESTE ARCHIVO A GIT
# ⚠️ CONFIGURA ESTAS VARIABLES DIRECTAMENTE EN RAILWAY

NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# 🔐 Base de Datos MongoDB
# Obtén esto de: https://cloud.mongodb.com → Connect → Drivers
# Formato: mongodb+srv://usuario:contraseña@cluster.mongodb.net/sportifyclub?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://usuario:contraseña@cluster.mongodb.net/sportifyclub?retryWrites=true&w=majority

# 🔐 Autenticación JWT
# Usa valores seguros y largos. Pueden ser cualquier string aleatorio
# Ej: openssl rand -base64 32
JWT_SECRET=your_super_secure_jwt_secret_here_at_least_32_characters_long
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_here_at_least_32_characters_long

# 🌐 CORS - URL exacta del frontend
# En producción: https://mara-frontend-production.up.railway.app
CORS_ORIGIN=https://mara-frontend-production.up.railway.app

# 📧 Email (OPCIONAL - para notificaciones)
MAILER_EMAIL=tu-email@gmail.com
MAILER_PASSWORD=tu-app-password-de-gmail

# 🖼️ Cloudinary (OPCIONAL - para upload de imágenes)
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret
